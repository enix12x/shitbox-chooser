[Unit]
Description=Shitbox Chooser Service
After=network.target

[Service]
Type=simple
User=XXXX
WorkingDirectory=/path/to/shitbox/chooser
ExecStart=/usr/bin/node /path/to/shitbox/chooser/server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target

